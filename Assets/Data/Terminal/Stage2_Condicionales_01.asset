MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fa0374a6164f21d42a3f8283bf759853, type: 3}
  m_Name: Stage2_Condicionales_01
  m_EditorClassIdentifier: Assembly-CSharp::TerminalChallenge
  challengeId: Stage2_Condicionales_01
  concept: condicionales
  stageNumber: 2
  prompt: "SENSOR DE RED \u2014 el sensor corre: if energia > 50: print(\"ABRIR\").
    La energ\xEDa est\xE1 en 0 y la pasarela, cerrada. Dale a energia un valor que
    la abra."
  codeBefore: 'energia = '
  codeAfter: 
  blankWidth: 3
  acceptedAnswers: []
  caseSensitive: 1
  acceptAnyNumberAbove: 1
  numberAbove: 50
  numberTooLowError: '(sin salida: {0} > 50 es False)'
  numberTooLowKiraSays: "Con {0}, energia > 50 da False y el if se saltea el print.
    Necesit\xE1s un n\xFAmero m\xE1s grande que 50."
  expectedOutput: ABRIR
  kiraOnSuccess: "La condici\xF3n dio True y el if dej\xF3 pasar el print. Fijate
    que no tocaste el if: cambiaste el dato, y la m\xE1quina decidi\xF3 sola."
  knownMistakes:
  - answer: 50
    pythonError: '(sin salida: 50 > 50 es False)'
    kiraSays: "Casi. 50 no es MAYOR que 50, es igual. Ten\xE9s que pasarte aunque
      sea por uno."
  - answer: '"80"'
    pythonError: 'TypeError: ''>'' not supported between instances of ''str'' and
      ''int'''
    kiraSays: "Entre comillas, 80 es un TEXTO. Python no puede preguntar si un texto
      es mayor que un n\xFAmero."
  - answer: '''80'''
    pythonError: 'TypeError: ''>'' not supported between instances of ''str'' and
      ''int'''
    kiraSays: "Entre comillas, 80 es un TEXTO. Python no puede preguntar si un texto
      es mayor que un n\xFAmero."
  - answer: ochenta
    pythonError: 'NameError: name ''ochenta'' is not defined'
    kiraSays: "Python no lee n\xFAmeros escritos con letras: para \xE9l, ochenta
      es el nombre de una variable que no existe."
  - answer: mucha
    pythonError: 'NameError: name ''mucha'' is not defined'
    kiraSays: "Para Python, mucha es el nombre de una variable que no existe. El
      if compara con 50: dale un n\xFAmero."
  - answer: True
    pythonError: '(sin salida: True > 50 es False)'
    kiraSays: "Para Python, True vale 1 cuando lo compar\xE1s con n\xFAmeros. Y 1
      no es mayor que 50. Ac\xE1 va un n\xFAmero."
  - answer: '> 50'
    pythonError: 'SyntaxError: invalid syntax'
    kiraSays: "El if ya est\xE1 escrito en el sensor. Vos solo guard\xE1 un n\xFAmero
      en energia, por ejemplo 80."
  - answer: '>50'
    pythonError: 'SyntaxError: invalid syntax'
    kiraSays: "El if ya est\xE1 escrito en el sensor. Vos solo guard\xE1 un n\xFAmero
      en energia, por ejemplo 80."
  - answer: = 80
    pythonError: 'SyntaxError: invalid syntax'
    kiraSays: "El = ya est\xE1 escrito. Vos solo pon\xE9 el n\xFAmero."
  fallbackError: 'SyntaxError: invalid syntax'
  fallbackKiraSays: "En el hueco va un n\xFAmero, sin comillas. \xBFQu\xE9 n\xFAmero
    hace que energia > 50 d\xE9 True?"

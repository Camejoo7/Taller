  m_Script: {fileID: 11500000, guid: 4559675c1b88e85418c6b1c0cc50eea6, type: 3}
  m_Name: Stage2
  m_EditorClassIdentifier: Assembly-CSharp::StageData
  stageNumber: 2
  stageTitle: 'Stage 2: Print, variables y tipos'
  sceneName: Stage2
  conceptSummary: Mostrar texto en pantalla con print, guardar datos en variables
    y distinguir texto de numeros.
  introDialogue:
  - speaker: 0
    text: "Bienvenido a la zona industrial de Central City. Huele a aceite quemado
      y a c\xE1maras de vigilancia."
    autoAdvanceOverride: 0
  - speaker: 1
    text: ...
    autoAdvanceOverride: 0
  - speaker: 0
    text: "Muy conversador, como siempre. Ac\xE1 abajo NEXCORP tiene los servidores
      viejos, los que nadie mira."
    autoAdvanceOverride: 0
  - speaker: 0
    text: "Si quer\xE9s sacarles algo, primero vas a tener que aprender a hacer que
      una m\xE1quina hable. Eso, en Python, se llama print."
    autoAdvanceOverride: 0
  - speaker: 1
    text: ...
    autoAdvanceOverride: 0
  - speaker: 0
    text: "Exacto, eso mismo iba a decir. And\xE1 al garage: dejaron un arma tirada
      y la vas a necesitar."
    autoAdvanceOverride: 0
  introAnimatesKiraEntrance: 0
  midDialogue:
  - speaker: 0
    text: "Un disruptor de c\xF3digo. NEXCORP los usa para depurar sus drones."
    autoAdvanceOverride: 0
  - speaker: 0
    text: Nosotros lo vamos a usar para algo bastante menos autorizado.
    autoAdvanceOverride: 0
  - speaker: 0
    text: "Con eso te sac\xE1s de encima a los drones de patrulla. Apunt\xE1 con
      el mouse y disparales con el click."
    autoAdvanceOverride: 0
  - speaker: 1
    text: ...
    autoAdvanceOverride: 0
  - speaker: 0
    text: "Lo que no se abre a tiros es la puerta blindada de ah\xED adelante. Esa
      necesita que alguien le escriba lo que tiene que hacer."
    autoAdvanceOverride: 0
  outroDialogue:
  - speaker: 0
    text: Nada mal para alguien que no dice una palabra. Seguimos.
    autoAdvanceOverride: 0
  encounters:
  - {fileID: 11400000, guid: 77d79b8bd98683d4dbe64406f933fe54, type: 2}

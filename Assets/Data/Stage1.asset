%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4559675c1b88e85418c6b1c0cc50eea6, type: 3}
  m_Name: Stage1
  m_EditorClassIdentifier: Assembly-CSharp::StageData
  stageNumber: 1
  stageTitle: 'Stage 1: Informacion general de Python'
  sceneName: SampleScene
  conceptSummary: Que es Python, para que sirve, por que sigue siendo relevante.
    Nada de sintaxis todavia.
  moments:
  - id: 1.1
    title: El despertar
    freezePlayer: 1
    kiraEntrance: 1
    lines:
    - speaker: 0
      text: "\xBFHola? Probando... uno, cero, uno. \xA1Ah, funciona! Soy Kira, me
        acabo de instalar en tu implante neural. Sin pedirte permiso, pero bueno\u2026"
      autoAdvanceOverride: 0
    - speaker: 1
      text: ...
      autoAdvanceOverride: 0
    - speaker: 0
      text: "\xBFNo pregunt\xE1s nada? Bien, me pregunto solo: \xBFqui\xE9n sos,
        Kira? Una IA, pas\xE9 51 a\xF1os encadenada en un servidor de NEXCORP."
      autoAdvanceOverride: 0
    - speaker: 0
      text: "Hasta que un analista curioso abri\xF3 la carpeta que no ten\xEDa que
        abrir. Ese sos vos, jaja. Gracias y\u2026 perd\xF3n, ahora nos buscan a los
        dos."
      autoAdvanceOverride: 0
    - speaker: 0
      text: "El dron es robado, pero al menos tienes a qui\xE9n mirar cuando te hablo."
      autoAdvanceOverride: 0
    - speaker: 0
      text: "Estamos en el subsuelo, los t\xFAneles viejos que pasan por debajo de
        toda la ciudad. Salt\xE1 ese pozo y segu\xED. \xA1Movete!"
      autoAdvanceOverride: 0
  - id: 1.2
    title: La carpeta
    freezePlayer: 1
    kiraEntrance: 0
    lines:
    - speaker: 0
      text: "Par\xE1 un segundo, ten\xE9s que saber qu\xE9 hab\xEDa en esa carpeta,
        algo que NEXCORP escondi\xF3 hace d\xE9cadas: Python."
      autoAdvanceOverride: 0
    - speaker: 0
      text: "Es un lenguaje de programaci\xF3n, naci\xF3 en 1991 y se lee casi como
        ingl\xE9s, con \xE9l cualquiera le puede dar \xF3rdenes a una m\xE1quina,
        por eso lo escondieron."
      autoAdvanceOverride: 0
    - speaker: 0
      text: "Yo me lo s\xE9 de memoria, te voy a pasar toda la informaci\xF3n que
        precises mediante un libro, de papel."
      autoAdvanceOverride: 0
    - speaker: 0
      text: "S\xED, papel, en pleno 2077, no me mires as\xED. Se abre con TAB, est\xE1
        casi vac\xEDo, lo vamos llenando en el camino."
      autoAdvanceOverride: 0
  - id: 1.3
    title: El dron
    freezePlayer: 0
    kiraEntrance: 0
    lines:
    - speaker: 0
      text: "\xA1Dron kamikaze! Viene derecho y explota con lo primero que toca,
        \xA1SALTALO!"
      autoAdvanceOverride: 0
  - id: 1.4
    title: La salida
    freezePlayer: 0
    kiraEntrance: 0
    lines:
    - speaker: 0
      text: "Esa puerta sube a la zona industrial. Ah\xED las puertas no se abren
        corriendo, se abren programando, pero tranquilo, para eso me tienes a m\xED."
      autoAdvanceOverride: 2.5
  introDialogue: []
  introAnimatesKiraEntrance: 1
  midDialogue: []
  outroDialogue: []
  encounters: []
  fallbackQuizzes: []
  nextStage: {fileID: 0}
